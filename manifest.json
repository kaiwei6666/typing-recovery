{
  "manifest_version": 3,
  "name": "Typing Recovery",
  "version": "0.3.0",
  "description": "Recover Traditional Chinese Zhuyin typed with the wrong keyboard layout.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.tw/*"
      ],
      "js": [
        "src/core/keymap.js",
        "src/core/syllable-parser.js",
        "src/core/dictionary.js",
        "src/core/candidates.js",
        "src/core/phrases.js",
        "src/core/ranker.js",
        "src/candidate-panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
